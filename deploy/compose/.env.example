# CollectFlow Docker Compose Configuration
# Copy this file to .env and adjust if needed

COLLECTFLOW_ENV=integration

# Host Port and Bind Address
# SECURITY NOTE: APP_BIND_IP defaults to 127.0.0.1 to prevent unencrypted HTTP exposure.
# Do NOT bind to 0.0.0.0 on public/cloud networks without TLS termination.
APP_BIND_IP=127.0.0.1
APP_PORT=8080

# Sibling Repository Layout for Local Source Builds
# Default assumes cash-flow-buddy-101 and collectflow are sibling folders.
FRONTEND_BUILD_CONTEXT=../../../cash-flow-buddy-101

# PostgreSQL Configuration
POSTGRES_DB=collectflow_integration
POSTGRES_USER=collectflow_user

# Note: Secret db_password must be written to deploy/compose/secrets/db_password.txt
